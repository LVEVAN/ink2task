# OAuth2 Desktop-app credentials from the Google Cloud Console.
# Copy this file to `credentials.env` and fill in your own values (see README.md).
# These are the *application's* credentials -- the per-user refresh token is
# obtained by `npm run authorize` and stored separately in
# ~/Ink2Task-Google/config.json, never here.

GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional. Loopback port the one-time `npm run authorize` listens on to catch
# the OAuth redirect. Only used during authorization, never by the running
# server. Change it only if 4571 is already taken on your machine.
# OAUTH_REDIRECT_PORT=4571
