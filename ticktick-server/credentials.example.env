# OAuth2 app credentials from the TickTick Developer Center
# (https://developer.ticktick.com/manage -- register an app there first).
# Copy this file to `credentials.env` and fill in your own values.
#
# These are the *application's* credentials -- the per-user access/refresh
# tokens are obtained by `npm run authorize` and stored separately in
# ~/.ink2task-ticktick/config.json, never here. Never commit credentials.env.

TICKTICK_CLIENT_ID=your-client-id
TICKTICK_CLIENT_SECRET=your-client-secret

# Must match EXACTLY one of the "OAuth redirect URL(s)" registered for your
# app in the TickTick Developer Center, including the path. This project uses
# a temporary loopback listener during `npm run authorize` only -- the running
# server never needs it again.
# OAUTH_REDIRECT_PORT=4577
