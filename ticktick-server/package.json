{
  "name": "ink2task-ticktick-server",
  "version": "0.1.0",
  "private": true,
  "description": "TickTick backend for the Ink2Task Supernote plugin -- a drop-in alternative to mac-server/google-tasks-server, runnable on any always-on host.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "authorize": "tsx src/authorize.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
